# Настройки резервного копирования. Копируется в /etc/hgz/backup.env, 0600 root:root.
# Заполняет владелец. Ключей доступа в репозитории нет.

# Публичный ключ age, которым шифруются копии. Приватный ключ — ТОЛЬКО у владельца
# (сгенерировать на своём компьютере: age-keygen -o hgz-backup-key.txt; распечатать, в сейф).
HGZ_BACKUP_AGE_RECIPIENT=age1...

# Удалённое хранилище (rclone remote, настроенный командой `rclone config` от root,
# тип s3 или совместимый: Yandex Object Storage, Selectel, VK Cloud и т. п.).
# Пусто — только локальные копии.
#
# Ключ доступа для сервера — ТОЛЬКО НА ЗАПИСЬ. backup.sh запускает rclone так,
# что ему не нужны ни список, ни чтение, ни HEAD (--no-check-dest,
# --s3-no-check-bucket, --s3-no-head, --s3-no-head-object, --s3-upload-cutoff 1G).
# Политика ключа — одно действие на объекты бакета:
#   { "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": "arn:aws:s3:::hgz-backups/*" }
# Не давать: s3:DeleteObject, s3:GetObject, s3:ListBucket. Взлом сервера тогда
# не удаляет и не читает старые копии. Если копия вырастет больше 1 ГБ,
# понадобится ещё s3:AbortMultipartUpload (составная загрузка).
#
# Что ключ не умеет — делает сам бакет: срок хранения (lifecycle: daily 14 дней,
# weekly 8 недель, monthly 12 месяцев) и версионирование/защита от удаления —
# настраиваются владельцем в панели хранилища. Проверить, что копия доехала,
# с сервера нельзя (нет чтения) — смотреть в панели или вторым ключом
# «только чтение» с компьютера владельца (им же скачивать копию для restore-test).
HGZ_BACKUP_REMOTE=hgz-s3:hgz-backups

# Сколько хранить локально / удалённо.
HGZ_BACKUP_KEEP_DAILY=14
HGZ_BACKUP_KEEP_WEEKLY=8
HGZ_BACKUP_KEEP_MONTHLY=12

# Пинг «копия сделана» / «копия не сделана» (healthchecks.io или свой URL). Пусто — не пинговать.
HGZ_BACKUP_PING_URL=

# Для restore-test: путь к приватному ключу age на сервере НЕ хранится.
# Тест восстановления расшифровывает копию ключом, который лежит только на
# отдельном носителе/машине владельца; на сервере он может быть временно,
# пока идёт тест, либо тест запускается с компьютера владельца.
HGZ_RESTORE_IDENTITY=/root/.config/hgz/age-identity.txt

# Куда слать тревоги мониторинга: команда, получающая текст на stdin
# (например: mail -s "Habez Gips" admin@habez-gips.ru). Пусто — только в журнал.
HGZ_ALERT_CMD=
