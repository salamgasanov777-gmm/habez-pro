# Habez Gips — обратный прокси с HTTPS. Ставится в /etc/caddy/Caddyfile.
# Сертификат Let's Encrypt, его продление и редирект http→https Caddy делает сам,
# как только DNS-запись домена указывает на этот сервер и открыты порты 80/443.
#
# Замените catalog.habez-gips.ru на свой домен (и ниже в /etc/hgz/hgz.env).

catalog.habez-gips.ru {
    encode zstd gzip

    # Заголовки безопасности, которых нет в приложении (HSTS, nosniff,
    # X-Frame-Options и Referrer-Policy оно ставит само).
    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Статика с хешем в имени не меняется — можно кешировать год.
    # Всё остальное (API, страницы, загрузки) отдаётся как есть, с теми
    # заголовками кеша, что ставит приложение; ответы с Authorization не кешируются.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Загрузка фото/PDF из панели — до 10 МБ в приложении, здесь чуть больше.
    request_body {
        max_size 12MB
    }

    # X-Forwarded-For / Proto / Host Caddy ставит сам; приложение верит им
    # только с 127.0.0.1 (TRUST_PROXY=loopback).
    reverse_proxy 127.0.0.1:4000 {
        transport http {
            read_timeout 60s
        }
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 14
            roll_keep_for 336h
        }
        format json
    }
}
