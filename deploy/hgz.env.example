# Переменные окружения production. Копируется в /etc/hgz/hgz.env, права 0640 root:hgz
# (читают systemd и команды от пользователя службы).
# Реальные значения задаёт владелец на сервере. В репозиторий этот файл с
# заполненными значениями не попадает никогда.

NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Домен сайта — везде один и тот же, с https://
PUBLIC_URL=https://catalog.habez-gips.ru
WEB_URL=https://catalog.habez-gips.ru
CORS_ORIGINS=https://catalog.habez-gips.ru

# Секрет подписи сессий. Сгенерировать на сервере:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Смена = все пользователи выйдут, гостевые ссылки на заказы перестанут работать.
JWT_SECRET=
COOKIE_SECURE=true

# Данные — вне папки с кодом (обязательно, иначе сервер не стартует).
DATABASE_FILE=/var/lib/hgz/hgz.db
UPLOAD_DIR=/var/lib/hgz/uploads

# Онлайн-оплаты нет: заказы оплачиваются менеджеру или по счёту.
PAYMENT_PROVIDER=none

# Вход по SMS появится с договором с SMS-провайдером; пока — по почте.
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# Контакт для служб push (Apple/Google) — почта завода, не личная.
VAPID_SUBJECT=mailto:sales@habez-gips.ru
# VAPID-ключи не задавать: создаются при первом старте в /var/lib/hgz/vapid.json
# и входят в резервную копию.

DEFAULT_TENANT=habez
TRUST_PROXY=loopback
LOG_LEVEL=info

# Telegram — по желанию, позже:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Habez AI: раздел «База знаний» (фаза 1). Включать по решению владельца.
AI_ENABLED=0
# Модель наблюдений Habez AI (Phase 2.2B): маршруты /api/ai/observations*.
# Включается отдельно от AI_ENABLED и только вместе с ним.
AI_EVIDENCE_ENABLED=0
# Чем отвечают старые /api/ai/specs, /intelligence, /compare: legacy (как раньше)
# или evidence (проекция наблюдений; споры — без числа). Только при AI_EVIDENCE_ENABLED=1.
AI_EVIDENCE_READ_MODE=legacy
# Habez AI Agent (чат по товарам). Только чтение базы. Нейросеть — через
# OpenRouter (Anthropic-совместимый вход). Ключ НЕ класть в репозиторий:
# только в .env на сервере (или в окружение службы).
AI_AGENT_ENABLED=0
# Покупателям и гостям на витрине (/ai) — отдельно: каждый ответ стоит денег.
AI_AGENT_PUBLIC=0
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-5
AI_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
# Длина ответа (токены) и сколько ждать модель, мс.
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=90000
# Защита от расходов. Вопросов за окно в минутах: сотруднику / гостю и
# покупателю (на человека: вошедшего — по учётной записи, гостя — по адресу).
AI_RATE_STAFF=60
AI_RATE_PUBLIC=12
AI_RATE_WINDOW_MIN=10
# Одновременных ответов одному человеку.
AI_MAX_CONCURRENT=2
# Всего ответов гостям и покупателям за сутки (0 — без общего предела).
AI_PUBLIC_DAILY_MAX=300
# Сколько знаков прошлой беседы передавать модели.
AI_HISTORY_MAX_CHARS=12000
