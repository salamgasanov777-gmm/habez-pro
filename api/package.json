{
  "name": "@hgz/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo-prices",
    "reset": "node src/db/migrate.js --fresh && node src/db/seed.js --demo-prices",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
