# ── Основное ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# В production по умолчанию 127.0.0.1 — наружу смотрит только nginx. В Docker: 0.0.0.0.
# HOST=127.0.0.1
# Чьим заголовкам X-Forwarded-* верить: loopback (по умолчанию), true, или список адресов/подсетей.
# TRUST_PROXY=loopback
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── База и файлы ────────────────────────────────────────────────────────────
# Для разработки — внутри api/var (в git не попадает). В production оба пути
# ОБЯЗАТЕЛЬНЫ, абсолютны и вне репозитория: сервер иначе не стартует.
#   DATABASE_FILE=/var/lib/hgz/hgz.db
#   UPLOAD_DIR=/var/lib/hgz/uploads
DATABASE_FILE=./var/hgz.db
UPLOAD_DIR=./var/uploads

# ── Безопасность ────────────────────────────────────────────────────────────
# Обязательно задать в проде: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
COOKIE_SECURE=false

# ── Тенант по умолчанию ─────────────────────────────────────────────────────
DEFAULT_TENANT=habez

# ── Платежи ─────────────────────────────────────────────────────────────────
# none — онлайн-оплаты нет (оплата менеджеру или по счёту). mock — имитация
# для демо-стенда, в production запрещена. yookassa — боевой режим.
PAYMENT_PROVIDER=none
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Уведомления ─────────────────────────────────────────────────────────────
SMS_PROVIDER=log
EMAIL_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Habez AI ────────────────────────────────────────────────────────────────
# Раздел «База знаний» в панели. Выключен по умолчанию; пока выключен,
# маршрутов /api/ai/* нет вовсе. Фаза 1 — только источники и факты,
# без обращения к нейросети и без выхода в интернет.
AI_ENABLED=0
# Модель наблюдений Habez AI (Phase 2.2B): маршруты /api/ai/observations*.
# Включается отдельно от AI_ENABLED и только вместе с ним.
AI_EVIDENCE_ENABLED=0
# Чем отвечают старые /api/ai/specs, /intelligence, /compare: legacy (как раньше)
# или evidence (проекция наблюдений; споры — без числа). Только при AI_EVIDENCE_ENABLED=1.
AI_EVIDENCE_READ_MODE=legacy
# Habez AI Agent (чат по товарам). Только чтение базы. Нейросеть — через
# OpenRouter (Anthropic-совместимый вход). Ключ НЕ класть в репозиторий:
# только в .env на сервере (или в окружение службы).
AI_AGENT_ENABLED=0
# Покупателям и гостям на витрине (/ai) — отдельно: каждый ответ стоит денег.
AI_AGENT_PUBLIC=0
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-5
AI_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
# Длина ответа (токены) и сколько ждать модель, мс.
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=90000
# Защита от расходов. Вопросов за окно в минутах: сотруднику / гостю и
# покупателю (на человека: вошедшего — по учётной записи, гостя — по адресу).
AI_RATE_STAFF=60
AI_RATE_PUBLIC=12
AI_RATE_WINDOW_MIN=10
# Одновременных ответов одному человеку.
AI_MAX_CONCURRENT=2
# Всего ответов гостям и покупателям за сутки (0 — без общего предела).
AI_PUBLIC_DAILY_MAX=300
# Сколько знаков прошлой беседы передавать модели.
AI_HISTORY_MAX_CHARS=12000
