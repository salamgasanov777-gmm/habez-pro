# ── Основное ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# В production по умолчанию 127.0.0.1 — наружу смотрит только nginx. В Docker: 0.0.0.0.
# HOST=127.0.0.1
# Чьим заголовкам X-Forwarded-* верить: loopback (по умолчанию), true, или список адресов/подсетей.
# TRUST_PROXY=loopback
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── База и файлы ────────────────────────────────────────────────────────────
DATABASE_FILE=./var/hgz.db
UPLOAD_DIR=./var/uploads

# ── Безопасность ────────────────────────────────────────────────────────────
# Обязательно задать в проде: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
COOKIE_SECURE=false

# ── Тенант по умолчанию ─────────────────────────────────────────────────────
DEFAULT_TENANT=habez

# ── Платежи ─────────────────────────────────────────────────────────────────
# none — онлайн-оплаты нет (оплата менеджеру или по счёту). mock — имитация
# для демо-стенда, в production запрещена. yookassa — боевой режим.
PAYMENT_PROVIDER=none
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Уведомления ─────────────────────────────────────────────────────────────
SMS_PROVIDER=log
EMAIL_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
