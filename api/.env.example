# ── Основное ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── База и файлы ────────────────────────────────────────────────────────────
DATABASE_FILE=./var/hgz.db
UPLOAD_DIR=./var/uploads

# ── Безопасность ────────────────────────────────────────────────────────────
# Обязательно задать в проде: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
COOKIE_SECURE=false

# ── Тенант по умолчанию ─────────────────────────────────────────────────────
DEFAULT_TENANT=habez

# ── Платежи ─────────────────────────────────────────────────────────────────
# mock — оплата имитируется локально, ключи не нужны. yookassa — боевой режим.
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Уведомления ─────────────────────────────────────────────────────────────
SMS_PROVIDER=log
EMAIL_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
